{
  "name": "@prerenderbuddy/engine",
  "version": "0.1.0",
  "description": "A secure, self-hosted rendering engine for serving crawler-readable HTML.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kopachlager/prerenderbuddy-engine.git"
  },
  "bugs": {
