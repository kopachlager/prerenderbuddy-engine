# Generate with: openssl rand -hex 32
PRERENDER_TOKEN=replace-me

# Required by default. Comma-separated exact hostnames.
ALLOWED_DOMAINS=example.com,www.example.com

# Explicitly opt into rendering any public hostname. Keep false unless your
# network also enforces strict outbound access controls.
ALLOW_ANY_PUBLIC_DOMAIN=false

# Host port used by Docker Compose. PORT remains the container port.
ENGINE_PORT=3000
PORT=3000
HEADLESS=true
RENDER_TIMEOUT_MS=20000
RENDER_MAX_REDIRECTS=10
RENDER_MAX_REQUESTS=250
RENDER_MAX_CONCURRENCY=4
RENDER_SINGLE_FLIGHT_WAIT_MS=30000
MAX_RENDERED_HTML_BYTES=5000000
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=500
CACHE_MAX_BYTES=100000000
DNS_LOOKUP_TIMEOUT_MS=2000

# Leave empty for a server-to-server API with no browser CORS access.
# Example: ALLOWED_ORIGINS=https://dashboard.example.com
ALLOWED_ORIGINS=
